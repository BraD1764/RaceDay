@model IEnumerable<RaceDay.MVC.Models.EventDto>

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold" style="border-left: 5px solid #ff5722; padding-left: 15px;">Upcoming Events</h2>
    </div>
    
    <div class="row">
        @if (Model is null || !Model.Any())
        {
            <div class="col-12 text-center text-muted mt-5">
                <h4>No events found. Check back later!</h4>
            </div>
        }
        
        @foreach (var ev in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title fw-bold">@ev.Title</h5>
                        <p class="text-muted mb-1"><i class="bi bi-geo-alt-fill"></i> @ev.City, @ev.Province</p>
                        <p class="text-muted"><i class="bi bi-calendar-event"></i> @ev.StartDate.ToString("dd MMM yyyy")</p>
                        <div class="mt-4">
                            <a asp-action="Enrol" asp-route-id="@ev.EventID" class="btn btn-primary w-100">Enrol Now</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>